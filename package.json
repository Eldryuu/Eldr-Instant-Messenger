{
  "name": "eim-desktop",
  "version": "1.0.1",
  "description": "Eldr Instant Messenger — Desktop Client",
  "homepage": "https://eldr.wtf",
  "author": {
    "name": "eldr",
    "email": "me@ryuu.no"
  },
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "build:linux": "electron-builder --linux AppImage",
    "build:win": "electron-builder --win nsis",
    "publish:linux": "electron-builder --linux AppImage --publish always",
    "publish:win": "electron-builder --win nsis      --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "wtf.eldr.eim",
    "productName": "EIM",
    "files": [
      "main.js",
      "preload.js",
      "src/**"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "maintainer": "eldr <me@ryuu.no>"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true
    },
    "publish": {
      "provider": "github",
      "owner": "Eldryuu",
      "repo": "Eldr-Instant-Messenger"
    }
  }
}
